{
  "name": "staff-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Cardyn Staff Customer Service Dashboard",
  "author": "Cardyn",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite --port 5173\" \"wait-on http://localhost:5173 && electron .\"",
    "web": "vite --port 5173",
    "build": "tsc -b && vite build",
    "electron:build": "npm run build && electron-builder --publish never",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-is": "^19.2.6",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.2",
    "electron": "^36.3.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.4",
    "typescript": "~6.0.2",
    "vite": "^8.0.9",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.cardyn.staff",
    "productName": "Cardyn Staff",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!dist/**/*.map",
      "!**/*.{ts,tsx,js.map}"
    ],
    "mac": {
      "target": [
        { "target": "zip",  "arch": ["arm64"] },
        { "target": "zip",  "arch": ["x64"] },
        { "target": "dmg",  "arch": ["arm64"] },
        { "target": "dmg",  "arch": ["x64"] }
      ],
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        { "target": "squirrel", "arch": ["x64"] },
        { "target": "nsis",     "arch": ["x64"] }
      ]
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
